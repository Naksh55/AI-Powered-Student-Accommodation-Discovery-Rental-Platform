# Using Neon (cloud Postgres + PostGIS) — no local Postgres/Docker install needed.
# 1. Create a free project at https://neon.tech
# 2. In the Neon SQL Editor, run: CREATE EXTENSION IF NOT EXISTS postgis;
# 3. Copy your connection string from the Neon dashboard and paste it below.
#    Make sure it ends with ?sslmode=require (Neon requires SSL).
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<your-project>.neon.tech/<dbname>?sslmode=require

JWT_SECRET_KEY=replace-with-a-long-random-string
CORS_ORIGINS=["http://localhost:3000"]
LLM_API_KEY=